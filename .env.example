# Frame.io Agent Starter — example config
# Copy this to .env (gitignored) and fill in the values.
# The `frameio-agent auth login` wizard can write these for you on first run.

# ──────────────────────────────────────────────────────────────────────────────
# Adobe IMS OAuth Web App credentials
#   1. https://developer.adobe.com/console/projects
#   2. Create a project → Add API → "Frame.io API"
#   3. Add credential → "OAuth Web App"
#   4. Set the Redirect URI to match FRAMEIO_REDIRECT_URI below
#   5. Copy Client ID + Client Secret here
# ──────────────────────────────────────────────────────────────────────────────
FRAMEIO_CLIENT_ID=your_client_id_here
FRAMEIO_CLIENT_SECRET=your_client_secret_here
FRAMEIO_REDIRECT_URI=http://localhost:8722/callback

# OAuth scopes the wizard will request. Defaults cover IMS user profile
# ("Connected as <email>") + Frame.io API access for v1's read commands AND
# the `share create` mutation. If `share create` fails with an insufficient-
# scope error, your OAuth Web App may need additional scopes granted in the
# Adobe Developer Console — then re-run `frameio-agent auth login`.
FRAMEIO_SCOPES=openid,profile,email,offline_access,additional_info.roles

# ──────────────────────────────────────────────────────────────────────────────
# Local token cache. Path is relative to the project root unless absolute.
# Never commit the real file — it is gitignored via .frameio-agent/.
# ──────────────────────────────────────────────────────────────────────────────
FRAMEIO_TOKEN_FILE=.frameio-agent/tokens.json

# ──────────────────────────────────────────────────────────────────────────────
# Frame.io V4 REST API base. The default works for the public service.
# ──────────────────────────────────────────────────────────────────────────────
FRAMEIO_API_BASE=https://api.frame.io/v4

# ──────────────────────────────────────────────────────────────────────────────
# Optional defaults so you don't need --account / --workspace on every command.
# Find IDs by running:  frameio-agent projects --json
# ──────────────────────────────────────────────────────────────────────────────
FRAMEIO_ACCOUNT_ID=
FRAMEIO_WORKSPACE_ID=
